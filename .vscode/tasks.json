{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "type": "shell",
                "command": "cmake --build build --config Debug --target unit_tests",
                "problemMatcher": ["$msCompile"]
            },
            "linux": {
             "type": "shell",
             "command": "cmake",
             "args": ["--build", "build"]
            }   
        },
        {
            "label": "Generate VS2022",
            "type": "shell",
            "command": "cmake -B build -G 'Visual Studio 17 2022' -A x64",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Generate Unit Tests",
            "type": "shell",
            "command": "cmake -B build -G 'Visual Studio 17 2022' -A x64",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build Unit Tests",
            "type": "shell",
            "command": "cmake --build build --config Debug --target unit_tests",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Generate and Build Unit Tests",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Generate Unit Tests",
                "Build Unit Tests"
            ]
        },
        
        {
            "label": "Run Tests Quick",
            "type": "shell",
            "command": "ctest --test-dir build -C Debug --output-on-failure -j 4",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Run Tests SLOW",
            "type": "shell",
            "command": "ctest --test-dir build -C Debug --verbose",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Run Test Range",
            "type": "shell",
            "command": "ctest --test-dir build -C Debug --verbose -I ${input:testRange}",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        },        
        {
            "label": "Run Test Regex",
            "type": "shell",
            "command": "ctest --test-dir build -C Debug --verbose -R \"${input:testFilter}\"",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        },        
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "cmake --build build --target clean",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        },
    ],
    "inputs": [
        {
            "id": "testRange",
            "type": "promptString",
            "description": "Enter test range ([n2-n3])"
        },
        {
            "id": "testFilter",
            "type": "promptString",
            "description": "Enter test regex"
        }
    ]
}